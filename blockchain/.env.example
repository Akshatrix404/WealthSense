# Copy this file to .env and fill in real values.
# .env is gitignored -- never commit real secrets.

# Polygon Amoy testnet RPC URL. Free public options: Alchemy, Infura, or
# the public RPC https://rpc-amoy.polygon.technology (less reliable for
# production use, fine for a student project).
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Private key of a TESTNET-ONLY wallet. This wallet must NEVER hold real
# funds -- fund it only with free Amoy test MATIC from a faucet, e.g.
# https://faucet.polygon.technology (select "Amoy"). Exporting a private
# key from MetaMask: Account Details -> Show Private Key.
AMOY_PRIVATE_KEY=

# Optional: only needed if you want `npx hardhat verify` to publish
# source code on Polygonscan's Amoy explorer. Get a free key at
# https://polygonscan.com/myapikey (same key works for Amoy).
POLYGONSCAN_API_KEY=
