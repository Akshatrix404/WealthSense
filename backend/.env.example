# Copy to .env and fill in real values. .env is gitignored.

# Polygon Amoy RPC URL (same as blockchain/.env's AMOY_RPC_URL)
RPC_URL=https://rpc-amoy.polygon.technology

# Server-side signing key. TESTNET-ONLY WALLET -- must never hold real
# funds. This is the ONE place a private key lives in the whole system;
# the Android app never sees it.
PRIVATE_KEY=

# Address printed by `npx hardhat run scripts/deploy.js --network amoy`
# in ../blockchain/
CONTRACT_ADDRESS=

# Polygon Amoy chain ID (don't change unless targeting a different network)
CHAIN_ID=80002

# Block explorer base URL for building tx links in responses
EXPLORER_BASE_URL=https://amoy.polygonscan.com/tx
